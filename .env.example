# Điền Token lấy từ @BotFather vào đây
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Cơ sở dữ liệu đám mây Turso (Cloud Database - Miễn phí 100%, vĩnh viễn không mất dữ liệu trên Render)
# Nếu để trống, bot sẽ tự động dùng SQLite cục bộ (bot_data.db)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token

# Khóa API VirusTotal v3 (Tùy chọn - Đăng ký tài khoản miễn phí tại virustotal.com)
# Cho phép quét virus & mã độc qua hơn 70 Antivirus hàng đầu thế giới (Kaspersky, BitDefender, Microsoft...)
# Nếu để trống, bot sẽ tự động sử dụng Smart Heuristic Shield nội bộ (0đ)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
