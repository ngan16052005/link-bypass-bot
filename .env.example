# Điền Token lấy từ @BotFather vào đây
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Cơ sở dữ liệu đám mây Turso (Cloud Database - Miễn phí 100%, vĩnh viễn không mất dữ liệu trên Render)
# Nếu để trống, bot sẽ tự động dùng SQLite cục bộ (bot_data.db)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token
